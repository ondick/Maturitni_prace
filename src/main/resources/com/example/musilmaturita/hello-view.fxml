<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:controller="com.example.musilmaturita.CipherController" spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">

    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
    </padding>

    <!-- Horní lišta s výběrem šifry a posunu -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="Šifra:"/>
        <ComboBox fx:id="cipherSelector" prefWidth="150.0"/>
        <Label text="Posun (Caesar):"/>
        <TextField fx:id="keyField" prefWidth="60.0" text="3"/>
    </HBox>

    <!-- Vstupní textové pole -->
    <Label text="Vstup:"/>
    <TextArea fx:id="inputArea" prefRowCount="4" promptText="Zadejte text k zpracování..."/>

    <!-- Tlačítka -->
    <HBox alignment="CENTER" spacing="10.0">
        <Button onAction="#onEncrypt" text="Šifrovat"/>
        <Button onAction="#onDecrypt" text="Dešifrovat"/>
    </HBox>

    <!-- Výstupní textové pole -->
    <Label text="Výstup:"/>
    <TextArea editable="false" fx:id="outputArea" prefRowCount="4" promptText="Výsledek..."/>

</VBox>